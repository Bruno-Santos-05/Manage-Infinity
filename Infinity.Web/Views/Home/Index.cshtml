@{
    ViewData["Title"] = "Início";
}

<div class="text-center">
    <div class="page-logo mx-auto mb-3" style="width:84px;height:84px;display:flex;align-items:center;justify-content:center;border-radius:24px;background:linear-gradient(135deg,#6366f1,#0ea5e9);font-size:2.6rem;color:#fff;box-shadow:0 14px 34px -10px rgba(99,102,241,.7);">
        <i class="bi bi-boxes"></i>
    </div>
    <h1 class="display-4 fw-bold" style="color:#1e293b;">Sistema Infinity</h1>
    <p class="lead text-muted fs-5">Gestão completa de Projetos de Impressão 3D</p>

    <div class="row g-4 mt-4 justify-content-center text-start">
        <div class="col-md-3">
            <div class="card card-shadow h-100">
                <div class="card-body">
                    <i class="bi bi-speedometer2 fs-2 text-primary"></i>
                    <h5 class="fw-bold mt-2">Dashboard</h5>
                    <p class="text-muted small mb-3">Acompanhe lucros, custos, grupos e os projetos mais rentáveis de forma visual.</p>
                    <a class="btn btn-primary btn-sm" asp-area="Dashboard" asp-controller="Dashboard" asp-action="Index">Abrir Dashboard <i class="bi bi-arrow-right"></i></a>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card card-shadow h-100">
                <div class="card-body">
                    <i class="bi bi-folder2-open fs-2 text-success"></i>
                    <h5 class="fw-bold mt-2">Projetos</h5>
                    <p class="text-muted small mb-3">Cadastre e gerencie seus projetos de impressão, com custos, vendas e lucros.</p>
                    <a class="btn btn-success btn-sm" asp-area="Projetos" asp-controller="Projetos" asp-action="Index">Ver Projetos <i class="bi bi-arrow-right"></i></a>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card card-shadow h-100">
                <div class="card-body">
                    <i class="bi bi-journal-plus fs-2 text-warning"></i>
                    <h5 class="fw-bold mt-2">Cadastros</h5>
                    <p class="text-muted small mb-3">Gerencie materiais, clientes, grupos, origens, níveis de pintura e configurações.</p>
                    <a class="btn btn-outline-secondary btn-sm" asp-area="Cadastros" asp-controller="Materiais" asp-action="Index">Acessar Cadastros <i class="bi bi-arrow-right"></i></a>
                </div>
            </div>
        </div>
    </div>
</div>
