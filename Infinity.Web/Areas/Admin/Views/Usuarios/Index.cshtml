@model IEnumerable<Infinity.Web.Models.Usuario>
@{
    ViewData["Title"] = "Usuários";
}
<div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-3">
    <div class="d-flex align-items-center">
        <span class="page-octicon"><i class="bi bi-people"></i></span>
        <div>
            <h3>Usuários</h3>
            <p class="page-subtitle">Gerenciamento de acesso ao sistema</p>
        </div>
    </div>
    <a class="btn btn-success" asp-action="Criar"><i class="bi bi-plus-lg"></i> Novo Usuário</a>
</div>

<div class="card card-shadow">
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Nome</th>
                    <th>Login</th>
                    <th>Ativo</th>
                    <th class="text-end">Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model)
                {
                    <tr>
                        <td>@u.Nome</td>
                        <td>@u.Login</td>
                        <td>
                            @if (u.Ativo)
                            {
                                <span class="badge bg-success">Ativo</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inativo</span>
                            }
                        </td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-warning" asp-action="Editar" asp-route-id="@u.Id"><i class="bi bi-pencil"></i> Editar</a>
                            <form asp-action="Excluir" asp-route-id="@u.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('Excluir este usuário?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-danger"><i class="bi bi-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (!Model.Any())
{
    <p class="text-muted mt-3">Nenhum usuário cadastrado.</p>
}
