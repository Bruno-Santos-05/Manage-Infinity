@model Infinity.Web.Models.Usuario
@{
    ViewData["Title"] = "Editar Usuário";
}
<div class="page-header d-flex align-items-center">
    <span class="page-octicon"><i class="bi bi-person-gear"></i></span>
    <div>
        <h3>Editar Usuário</h3>
        <p class="page-subtitle">Atualize os dados do usuário</p>
    </div>
</div>
<div class="card card-shadow">
    <div class="card-body">
        <form asp-action="Editar" method="post">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Nome" class="form-label"></label>
                    <input asp-for="Nome" class="form-control" />
                    <span asp-validation-for="Nome" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Login" class="form-label"></label>
                    <input asp-for="Login" class="form-control" />
                    <span asp-validation-for="Login" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Senha" class="form-label"></label>
                    <input asp-for="Senha" class="form-control" type="password" placeholder="Deixe em branco para não alterar" />
                    <span asp-validation-for="Senha" class="text-danger small"></span>
                </div>
                <div class="col-md-6 d-flex align-items-end">
                    <div class="form-check form-switch">
                        <input asp-for="Ativo" class="form-check-input" type="checkbox" />
                        <label asp-for="Ativo" class="form-check-label"></label>
                    </div>
                </div>
            </div>
            <div class="mt-4">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Salvar</button>
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
