@model IEnumerable<Infinity.Web.Models.Material>
@{
    ViewData["Title"] = "Materiais";
    var tipos = ViewBag.TiposMaterial as List<string> ?? new List<string>();
    var fornecedores = ViewBag.Fornecedores as List<string> ?? new List<string>();
    var cores = ViewBag.Cores as List<string> ?? new List<string>();
    string? tipoSel = ViewBag.TipoMaterialSelecionado;
    string? fornSel = ViewBag.FornecedorSelecionado;
    string? corSel = ViewBag.CorSelecionada;
    string? statusSel = ViewBag.StatusSelecionado;
}
<div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-3">
    <div class="d-flex align-items-center">
        <span class="page-octicon"><i class="bi bi-box-seam"></i></span>
        <div>
            <h3>Materiais</h3>
            <p class="page-subtitle">Cadastro de filamentos e matérias-primas</p>
        </div>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a class="btn btn-success" asp-action="Criar"><i class="bi bi-plus-lg"></i> Novo Material</a>
    </div>
</div>

<div class="card card-shadow mb-3">
    <div class="card-body py-3">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-12 col-md-3">
                <label class="form-label small text-muted mb-1">Buscar</label>
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-white"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="busca" value="@ViewBag.Busca" class="form-control" placeholder="Buscar texto..." />
                </div>
            </div>
            <div class="col-6 col-md-2">
                <label class="form-label small text-muted mb-1">Tipo de Material</label>
                <select name="tipoMaterial" class="form-select form-select-sm">
                    <option value="">Todos</option>
                    @foreach (var t in tipos)
                    {
                        <option value="@t" selected="@(t == tipoSel ? "selected" : null)">@t</option>
                    }
                </select>
            </div>
            <div class="col-6 col-md-2">
                <label class="form-label small text-muted mb-1">Fornecedor</label>
                <select name="fornecedor" class="form-select form-select-sm">
                    <option value="">Todos</option>
                    @foreach (var f in fornecedores)
                    {
                        <option value="@f" selected="@(f == fornSel ? "selected" : null)">@f</option>
                    }
                </select>
            </div>
            <div class="col-6 col-md-2">
                <label class="form-label small text-muted mb-1">Cor</label>
                <select name="cor" class="form-select form-select-sm">
                    <option value="">Todas</option>
                    @foreach (var c in cores)
                    {
                        <option value="@c" selected="@(c == corSel ? "selected" : null)">@c</option>
                    }
                </select>
            </div>
            <div class="col-6 col-md-1">
                <label class="form-label small text-muted mb-1">Status</label>
                <select name="status" class="form-select form-select-sm">
                    <option value="">Todos</option>
                    <option value="ativos" selected="@(statusSel == "ativos" ? "selected" : null)">Ativos</option>
                    <option value="inativos" selected="@(statusSel == "inativos" ? "selected" : null)">Desativados</option>
                </select>
            </div>
            <div class="col-12 col-md-2 d-flex gap-1">
                <button class="btn btn-sm btn-primary flex-grow-1" type="submit">
                    <i class="bi bi-funnel"></i> Filtrar
                </button>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary" title="Limpar filtros">
                    <i class="bi bi-x-lg"></i> Limpar
                </a>
            </div>
        </form>
    </div>
</div>

<div class="card card-shadow">
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Tipo de Material</th>
                    <th>Fornecedor</th>
                    <th>Cor</th>
                    <th class="text-end">Valor</th>
                    <th class="text-end">Peso (g)</th>
                    <th class="text-end">R$/g</th>
                    <th>Status</th>
                    <th class="text-end">Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var m in Model)
                {
                    <tr class="@(m.Ativo ? "" : "opacity-50")">
                        <td class="fw-semibold">@m.TipoMaterial</td>
                        <td>@m.Fornecedor</td>
                        <td>@m.Cor</td>
                        <td class="text-end">@m.Valor.ToString("C")</td>
                        <td class="text-end">@m.PesoCompra.ToString("0.###")</td>
                        <td class="text-end">@m.PrecoPorGrama.ToString("C2")</td>
                        <td>
                            @if (m.Ativo)
                            {
                                <span class="badge bg-success"><i class="bi bi-check-circle"></i> Ativo</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary"><i class="bi bi-dash-circle"></i> Desativado</span>
                            }
                        </td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-warning" asp-action="Editar" asp-route-id="@m.Id"><i class="bi bi-pencil"></i> Editar</a>
                            <button type="button"
                                    class="btn btn-sm btn-danger"
                                    title="Excluir permanentemente"
                                    onclick="abrirModalExclusao(@m.Id, '@Html.Raw( System.Web.HttpUtility.JavaScriptStringEncode($"{m.TipoMaterial} - {m.Fornecedor}" + (!string.IsNullOrWhiteSpace(m.Cor) ? $" ({m.Cor})" : "")) )')">
                                <i class="bi bi-trash"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
@if (!Model.Any())
{
    <p class="text-muted mt-3">Nenhum material encontrado.</p>
}

<!-- Modal moderno de confirmação de exclusão -->
<div class="modal fade" id="modalConfirmarExclusao" tabindex="-1" aria-labelledby="modalExclusaoLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 16px; overflow: hidden;">
            <div class="modal-body p-4 text-center">
                <div class="mx-auto mb-3 d-flex align-items-center justify-content-center rounded-circle"
                     style="width: 68px; height: 68px; background-color: #fee2e2; color: #dc2626;">
                    <i class="bi bi-exclamation-triangle-fill" style="font-size: 2rem;"></i>
                </div>
                <h5 class="fw-bold mb-2" id="modalExclusaoLabel" style="color: #1e293b;">Excluir Material Permanentemente?</h5>
                <p class="text-muted mb-2">
                    Você está prestes a excluir de vez o material:
                </p>
                <div class="p-2 mb-3 rounded fw-semibold" style="background-color: #f8fafc; color: #0f172a; border: 1px solid #e2e8f0;" id="nomeMaterialExclusao">
                </div>
                <p class="small text-danger mb-4">
                    <i class="bi bi-info-circle me-1"></i>Esta ação apagará o registro definitivamente do banco de dados e não poderá ser desfeita.
                </p>
                <form id="formExcluirMaterial" asp-action="Excluir" method="post" class="d-flex gap-2 justify-content-center">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="idMaterialExclusao" value="" />
                    <button type="button" class="btn btn-light px-4 fw-semibold" data-bs-dismiss="modal" style="border: 1px solid #cbd5e1;">
                        Cancelar
                    </button>
                    <button type="submit" class="btn btn-danger px-4 fw-semibold shadow-sm">
                        <i class="bi bi-trash3-fill me-1"></i> Sim, Excluir de Vez
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function abrirModalExclusao(id, nome) {
            document.getElementById('idMaterialExclusao').value = id;
            document.getElementById('nomeMaterialExclusao').textContent = nome;
            var modalEl = document.getElementById('modalConfirmarExclusao');
            var modal = bootstrap.Modal.getOrCreateInstance(modalEl);
            modal.show();
        }
    </script>
}
