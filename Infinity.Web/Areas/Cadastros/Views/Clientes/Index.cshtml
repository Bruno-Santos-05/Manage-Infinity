@model IEnumerable<Infinity.Web.Models.Cliente>
@{
    ViewData["Title"] = "Clientes";
}
<div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-3">
    <div class="d-flex align-items-center">
        <span class="page-octicon"><i class="bi bi-person-lines-fill"></i></span>
        <div>
            <h3>Clientes</h3>
            <p class="page-subtitle">Cadastro de clientes e origem</p>
        </div>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <form method="get" class="d-flex gap-2">
            <div class="input-group">
                <span class="input-group-text bg-white"><i class="bi bi-search text-muted"></i></span>
                <input type="text" name="busca" value="@ViewBag.Busca" class="form-control" placeholder="Buscar..." />
            </div>
            <button class="btn btn-outline-secondary" type="submit">Buscar</button>
        </form>
        <a class="btn btn-success" asp-action="Criar"><i class="bi bi-plus-lg"></i> Novo Cliente</a>
    </div>
</div>

<div class="card card-shadow">
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Nome Completo</th>
                    <th>Número Celular</th>
                    <th>Nos Conheceu Por Onde?</th>
                    <th>OBS</th>
                    <th class="text-end">Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td class="fw-semibold">@c.NomeCompleto</td>
                        <td>@c.NumeroCelular</td>
                        <td><span class="badge bg-secondary">@(c.Origem?.Nome ?? "-")</span></td>
                        <td class="small text-muted">@(c.Obs != null && c.Obs.Length > 40 ? c.Obs.Substring(0, 40) + "..." : c.Obs)</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-warning" asp-action="Editar" asp-route-id="@c.Id"><i class="bi bi-pencil"></i> Editar</a>
                            <form asp-action="Excluir" asp-route-id="@c.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('Excluir este cliente?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-danger"><i class="bi bi-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
@if (!Model.Any())
{
    <p class="text-muted mt-3">Nenhum cliente encontrado.</p>
}
