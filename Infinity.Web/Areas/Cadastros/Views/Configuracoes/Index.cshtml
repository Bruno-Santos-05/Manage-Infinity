@model Infinity.Web.Areas.Cadastros.Controllers.ConfiguracoesController.ConfigViewModel
@{
    ViewData["Title"] = "Configurações Financeiras";
}
<div class="page-header d-flex align-items-center">
    <span class="page-octicon"><i class="bi bi-gear"></i></span>
    <div>
        <h3>Configurações Financeiras</h3>
        <p class="page-subtitle">Valores padrão aplicados ao criar novos projetos</p>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-7">
        <div class="card card-shadow">
            <div class="card-body">
                <form asp-action="Index" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="LucroDesejadoPadrao" class="form-label">Lucro Desejado Padrão (%)</label>
                            <div class="input-group">
                                <input asp-for="LucroDesejadoPadrao" class="form-control" type="number" step="0.01" min="0" />
                                <span class="input-group-text">%</span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ValorHoraMaquinaPadrao" class="form-label">Valor da Hora Máquina Padrão (R$)</label>
                            <div class="input-group">
                                <span class="input-group-text">R$</span>
                                <input asp-for="ValorHoraMaquinaPadrao" class="form-control" type="number" step="0.01" min="0" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="MetodoPagamentoPadrao" class="form-label">Método de Pagamento Padrão</label>
                            <select asp-for="MetodoPagamentoPadrao" class="form-select">
                                <option value="PIX">PIX</option>
                                <option value="CARTÃO">Cartão</option>
                                <option value="DINHEIRO">Dinheiro</option>
                            </select>
                        </div>
                    </div>
                    <div class="mt-4">
                        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Salvar Configurações</button>
                    </div>
                </form>
                <p class="text-muted small mt-3 mb-0">
                    Estes valores serão usados como padrão ao criar um novo projeto, podendo ser alterados em cada projeto.
                </p>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
