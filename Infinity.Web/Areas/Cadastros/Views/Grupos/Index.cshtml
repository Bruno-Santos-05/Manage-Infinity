@model IEnumerable<Infinity.Web.Models.Grupo>
@{
    ViewData["Title"] = "Grupos de Projeto";
}
<div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-3">
    <div class="d-flex align-items-center">
        <span class="page-octicon"><i class="bi bi-collection"></i></span>
        <div>
            <h3>Grupos de Projeto</h3>
            <p class="page-subtitle">Organize seus projetos em grupos</p>
        </div>
    </div>
    <a class="btn btn-success" asp-action="Criar"><i class="bi bi-plus-lg"></i> Novo Grupo</a>
</div>

<div class="card card-shadow">
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Nome</th>
                    <th>Descrição</th>
                    <th class="text-end">Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var g in Model)
                {
                    <tr>
                        <td class="fw-semibold">@g.Nome</td>
                        <td>@g.Descricao</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-warning" asp-action="Editar" asp-route-id="@g.Id"><i class="bi bi-pencil"></i> Editar</a>
                            <form asp-action="Excluir" asp-route-id="@g.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('Excluir este grupo?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-danger"><i class="bi bi-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
@if (!Model.Any())
{
    <p class="text-muted mt-3">Nenhum grupo cadastrado.</p>
}
