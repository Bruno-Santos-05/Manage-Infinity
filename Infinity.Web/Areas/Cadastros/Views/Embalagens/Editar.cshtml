@model Infinity.Web.Models.Embalagem
@{
    ViewData["Title"] = "Editar Embalagem";
}
<div class="page-header d-flex align-items-center">
    <span class="page-octicon"><i class="bi bi-box2-heart"></i></span>
    <div>
        <h3>Editar Embalagem</h3>
        <p class="page-subtitle">Atualize o nome ou o valor unitário da embalagem</p>
    </div>
</div>
<div class="card card-shadow">
    <div class="card-body">
        <form asp-action="Editar" method="post">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Nome" class="form-label"></label>
                    <input asp-for="Nome" class="form-control" />
                    <span asp-validation-for="Nome" class="text-danger small"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="ValorUnitario" class="form-label">Valor Unitário (R$)</label>
                    <div class="input-group">
                        <span class="input-group-text">R$</span>
                        <input asp-for="ValorUnitario" class="form-control" type="number" step="0.01" min="0" />
                    </div>
                    <span asp-validation-for="ValorUnitario" class="text-danger small"></span>
                </div>
                <div class="col-md-3 d-flex align-items-end">
                    <div class="form-check form-switch">
                        <input asp-for="Ativo" class="form-check-input" type="checkbox" />
                        <label asp-for="Ativo" class="form-check-label">
                            @(Model.Ativo ? "Ativo" : "Desativado")
                        </label>
                    </div>
                </div>
            </div>
            <div class="mt-4">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Salvar</button>
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
