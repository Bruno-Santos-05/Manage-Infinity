@model IEnumerable<Infinity.Web.Areas.Projetos.Controllers.ProjetoListaVM>
@{
    ViewData["Title"] = "Projetos";
    var clientes = ViewBag.Clientes as List<Infinity.Web.Models.Cliente> ?? new List<Infinity.Web.Models.Cliente>();
    var grupos = ViewBag.Grupos as List<Infinity.Web.Models.Grupo> ?? new List<Infinity.Web.Models.Grupo>();
    string? pagoSel = ViewBag.PagoSelecionado;
    int? clienteIdSel = ViewBag.ClienteIdSelecionado;
    int? grupoIdSel = ViewBag.GrupoIdSelecionado;
}
<div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-3">
    <div class="d-flex align-items-center">
        <span class="page-octicon"><i class="bi bi-folder2-open"></i></span>
        <div>
            <h3>Projetos</h3>
            <p class="page-subtitle">Gerencie seus projetos de impressão 3D, custos, vendas e lucros</p>
        </div>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a class="btn btn-success" asp-action="Criar"><i class="bi bi-plus-lg"></i> Novo Projeto</a>
        <a class="btn btn-outline-success" asp-action="ExportarExcel"><i class="bi bi-file-earmark-excel"></i> Excel</a>
        <a class="btn btn-outline-danger" asp-action="ExportarPdf"><i class="bi bi-file-earmark-pdf"></i> PDF</a>
    </div>
</div>

<div class="card card-shadow mb-3">
    <div class="card-body py-3">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-12 col-md-3">
                <label class="form-label small text-muted mb-1">Buscar</label>
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-white"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="busca" value="@ViewBag.Busca" class="form-control" placeholder="Buscar por nome/grupo/cliente..." />
                </div>
            </div>
            <div class="col-6 col-md-2">
                <label class="form-label small text-muted mb-1">Pagamento</label>
                <select name="pago" class="form-select form-select-sm">
                    <option value="">Todos</option>
                    <option value="sim" selected="@(pagoSel == "sim" ? "selected" : null)">Pago</option>
                    <option value="nao" selected="@(pagoSel == "nao" ? "selected" : null)">Não Pago (A receber)</option>
                </select>
            </div>
            <div class="col-6 col-md-3">
                <label class="form-label small text-muted mb-1">Cliente</label>
                <select name="clienteId" class="form-select form-select-sm">
                    <option value="">Todos os clientes</option>
                    @foreach (var c in clientes)
                    {
                        <option value="@c.Id" selected="@(clienteIdSel == c.Id ? "selected" : null)">@c.NomeCompleto</option>
                    }
                </select>
            </div>
            <div class="col-6 col-md-2">
                <label class="form-label small text-muted mb-1">Grupo de Projetos</label>
                <select name="grupoId" class="form-select form-select-sm">
                    <option value="">Todos os grupos</option>
                    <option value="-1" selected="@(grupoIdSel == -1 ? "selected" : null)">(Sem grupo)</option>
                    @foreach (var g in grupos)
                    {
                        <option value="@g.Id" selected="@(grupoIdSel == g.Id ? "selected" : null)">@g.Nome</option>
                    }
                </select>
            </div>
            <div class="col-6 col-md-2 d-flex gap-1">
                <button class="btn btn-sm btn-primary flex-grow-1" type="submit">
                    <i class="bi bi-funnel"></i> Filtrar
                </button>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary" title="Limpar filtros">
                    <i class="bi bi-x-lg"></i> Limpar
                </a>
            </div>
        </form>
    </div>
</div>

<div class="card card-shadow">
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Projeto</th>
                    <th>Cliente(s)</th>
                    <th class="text-end">Mat. Est.</th>
                    <th class="text-end">Mat. Real</th>
                    <th class="text-end">Custo Est.</th>
                    <th class="text-end">Custo Real</th>
                    <th class="text-end">Venda</th>
                    <th class="text-end">Lucro Esperado</th>
                    <th class="text-end">Lucro Real</th>
                    <th class="text-end">Dif. Lucro</th>
                    <th class="text-end">Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    var f = item.Financeiro;
                    <tr>
                        <td>
                            <div class="fw-semibold">@item.Projeto.Nome</div>
                            @if (!string.IsNullOrWhiteSpace(item.Projeto.Descricao))
                            {
                                <div class="small text-muted text-truncate" style="max-width:260px;" title="@item.Projeto.Descricao">@item.Projeto.Descricao</div>
                            }
                            <small class="text-muted">
                                <span class="badge bg-info text-dark">@(item.Projeto.Grupo?.Nome ?? "Sem grupo")</span>
                                @if (item.Projeto.Pago)
                                {
                                    <text> · <span class="badge bg-success"><i class="bi bi-check-circle-fill"></i> Pago</span></text>
                                }
                                else
                                {
                                    <text> · <span class="badge bg-warning text-dark"><i class="bi bi-clock"></i> A receber</span></text>
                                }
                            </small>
                        </td>
                        <td class="small">@string.Join(", ", item.Clientes)</td>
                        <td class="text-end small">@f.MaterialEstimado.ToString("0.##")</td>
                        <td class="text-end small">@f.MaterialReal.ToString("0.##")</td>
                        <td class="text-end">@f.CustoTotalEstimado.ToString("C")</td>
                        <td class="text-end">@f.CustoTotalReal.ToString("C")</td>
                        <td class="text-end">@f.ValorVenda.ToString("C")</td>
                        <td class="text-end">
                            <span class="badge @(f.LucroEsperado >= 0 ? "bg-success" : "bg-danger")">
                                @f.LucroEsperado.ToString("C")
                            </span>
                        </td>
                        <td class="text-end">
                            @if (f.TemDadosReais)
                            {
                                <span class="badge @(f.LucroReal >= 0 ? "bg-primary" : "bg-danger")">
                                    @f.LucroReal.ToString("C")
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary text-muted" title="Ainda não há dados reais de consumo (material/horas).">—</span>
                            }
                        </td>
                        <td class="text-end small text-nowrap">
                            @if (f.TemDadosReais)
                            {
                                <span class="d-inline-flex align-items-center @(f.DiffLucro >= 0 ? "text-success" : "text-danger")">
                                    @if (f.DiffLucro >= 0)
                                    {
                                        <i class="bi bi-arrow-up-circle-fill me-1"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-arrow-down-circle-fill me-1"></i>
                                    }
                                    @(f.DiffLucro >= 0 ? "+" : "-")@Math.Abs(f.DiffLucro).ToString("C")
                                </span>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-primary" asp-action="Detalhes" asp-route-id="@item.Projeto.Id"><i class="bi bi-eye"></i></a>
                            <a class="btn btn-sm btn-warning" asp-action="Editar" asp-route-id="@item.Projeto.Id"><i class="bi bi-pencil"></i></a>
                            <form asp-action="Excluir" asp-route-id="@item.Projeto.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('Excluir este projeto?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-danger"><i class="bi bi-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
@if (!Model.Any())
{
    <p class="text-muted mt-3">Nenhum projeto encontrado.</p>
}
