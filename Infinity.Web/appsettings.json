{
  "ConnectionStrings": {
    // ============================================================================
    // BANCO DE DADOS GRATUITO E PORTÁTIL (SQLite)
    // ----------------------------------------------------------------------------
    // SQLite é 100% gratuito, não precisa instalar servidor e o banco inteiro é
    // UM ÚNICO ARQUIVO: Infinity.Web\Data\infinity.db
    //
    // - Para TROCAR DE COMPUTADOR: copie a pasta do projeto (ou só o arquivo
    //   Infinity.Web\Data\infinity.db) para o outro PC junto com o código.
    // - Para HOSPEDAR NA INTERNET: publique a aplicação e suba junto o arquivo
    //   infinity.db (a maioria dos hosts gratuitos aceita SQLite).
    // ============================================================================
    // "Journal Mode=Delete" (rollback journal) é configurado via PRAGMA no DbSeeder
    // (Infinity.Web\Services\DbSeeder.cs), mantendo o banco em UM ÚNICO ARQUIVO
    // Data\infinity.db — ideal para copiar/colar ao trocar de computador.
    // ============================================================================
    "DefaultConnection": "Data Source=Data\\infinity.db;Foreign Keys=True"

    // ----------------------------------------------------------------------------
    // Opcional — se um dia quiser usar SQL Server (requer instalação/servidor):
    // ----------------------------------------------------------------------------
    // "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=InfinitySistema;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
